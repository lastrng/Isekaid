# Client-side Supabase configuration. The anon key is public by design; never
# put a service-role key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional content-generation scripts
ANTHROPIC_API_KEY=
PRECONCU_MODEL=claude-haiku-4-5-20251001
GOOGLE_PLACES_KEY=
GOOGLE_TTS_API_KEY=
WIKI_CONTACT=https://your-domain.example
