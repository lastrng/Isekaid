# Client-side Supabase configuration. The anon key is public by design; never
# put a service-role key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public SDK keys (safe to embed in the corresponding native client).
VITE_REVENUECAT_API_KEY=goog_your-public-android-key
VITE_REVENUECAT_IOS_API_KEY=appl_your-public-ios-key

# Optional content-generation scripts
ANTHROPIC_API_KEY=
PRECONCU_MODEL=claude-haiku-4-5-20251001
GOOGLE_PLACES_KEY=
GOOGLE_TTS_API_KEY=
WIKI_CONTACT=https://your-domain.example
